{
  "name": "medi-pharm-desktop",
  "productName": "MediPharm Desktop Preview",
  "version": "0.1.3",
  "private": true,
  "description": "Offline Windows pharmacy desktop application \u2014 development preview",
  "author": "Fructum",
  "license": "UNLICENSED",
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.desktop.json",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "package": "electron-forge package",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "lint": "eslint src tests *.config.*",
    "format": "prettier --write src tests *.config.* package.json tsconfig*.json index.html",
    "format:check": "prettier --check src tests *.config.* package.json tsconfig*.json index.html",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:recovery": "vitest run tests/recovery"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "prettier": "3.9.10"
  }
}
