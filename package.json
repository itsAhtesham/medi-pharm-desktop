{
  "name": "medi-pharm-desktop",
  "productName": "MediPharm Prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Windows pharmacy desktop application — platform prototype",
  "author": "Fructum",
  "license": "UNLICENSED",
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "playwright test",
    "package": "electron-forge package",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
